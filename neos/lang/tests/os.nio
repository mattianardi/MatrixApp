fs.mkdir("/tmp/nio_t")
fs.write("/tmp/nio_t/a.txt", "one\ntwo\n")
fs.append("/tmp/nio_t/a.txt", "three\n")
let lines = split(trim(fs.read("/tmp/nio_t/a.txt")), "\n")
println(len(lines), lines, fs.exists("/tmp/nio_t/a.txt"), fs.exists("/tmp/nio_t/none"))
fs.write("/tmp/nio_t/b.txt", "x")
println(fs.list("/tmp/nio_t") |> map(.name))
println(sh("echo from-shell; echo $((6*7))") |> trim() |> split("\n"))
println(run("true"), run("false"), capture("echo", "direct", "args") |> trim())
let t0 = now(); sleep(30); println(now() - t0 >= 25)
println(env.get("NIO_TEST_VAR"), env.get("NOPE"), type(env.PATH), len(args))
fs.remove("/tmp/nio_t/a.txt"); fs.remove("/tmp/nio_t/b.txt")
println(fs.list("/tmp/nio_t") |> len)
